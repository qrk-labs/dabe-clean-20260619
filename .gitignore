# Python/runtime caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environments and build outputs
.venv/
venv/
env/
*.egg-info/
build/
dist/

# Local experiment/runtime output
logs/
outputs/
wandb/
checkpoints/
*.log

# Heavy model/data artifacts. Keep experiment configs/results in Git; store
# checkpoints, tensors, and arrays in Modal volumes or dedicated artifact stores.
*.ckpt
*.pt
*.pth
*.safetensors
*.npy
*.npz
*.bin

# Lightning/WandB internals inside experiment folders
experiments/**/logs/
experiments/**/checkpoints/
experiments/**/artifacts/
experiments/**/wandb/

# Workspace-local binary tool installs
research/.tools/
tmp/

# EXP-094 duplicates full diagnostics in these wrapper payloads; keep decode_diagnostics.json instead.
experiments/modal_downloads/exp094_modal_dabe_repair_trace_diag_001/pipeline_summary.json
experiments/modal_downloads/exp094_modal_dabe_repair_trace_diag_001/stage_result.json
