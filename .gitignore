# Python/runtime caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environments and build outputs
.venv/
venv/
env/
*.egg-info/
build/
dist/

# Local experiment/runtime output
logs/
outputs/
wandb/
checkpoints/
*.log

# Heavy model/data artifacts. Keep experiment configs/results in Git; store
# checkpoints, tensors, and arrays in Modal volumes or dedicated artifact stores.
*.ckpt
*.pt
*.pth
*.safetensors
*.npy
*.npz
*.bin

# Lightning/WandB internals inside experiment folders
experiments/**/logs/
experiments/**/checkpoints/
experiments/**/artifacts/
experiments/**/wandb/

# Workspace-local binary tool installs
research/.tools/
tmp/

# Generated Zenodo upload bundles. Keep metadata/scripts in Git, rebuild these
# locally when reserving the final DOI or preparing an upload.
zenodo/deposit/
zenodo/*.zip

# Local generated TMLR export artifacts; Typst is the canonical paper source.
research/paper_tex/main_tmlr.*
research/paper_tex/tmlr-ready.pdf
research/paper_tex/tmlr.bst
research/paper_tex/tmlr.sty

# EXP-094 duplicates full diagnostics in these wrapper payloads; keep decode_diagnostics.json instead.
experiments/modal_downloads/exp094_modal_dabe_repair_trace_diag_001/pipeline_summary.json
experiments/modal_downloads/exp094_modal_dabe_repair_trace_diag_001/stage_result.json
.DS_Store
# Diagnostic stage_result payloads duplicate decode_diagnostics.json for these paper-defense probes.
experiments/modal_downloads/exp096_modal_dabe_fixed20_inference_diag_001/stage_result.json
experiments/modal_downloads/exp097_modal_dabe_python_code_diag_001/stage_result.json
